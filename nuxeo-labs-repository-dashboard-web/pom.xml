<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.nuxeo.labs.dashboard</groupId>
    <artifactId>nuxeo-labs-repository-dashboard-parent</artifactId>
    <version>2025.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nuxeo-labs-repository-dashboard-web</artifactId>
  <packaging>jar</packaging>
  <name>Nuxeo Labs Repository Dashboard - Web</name>
  <description>Angular single page application plus the Nuxeo bundle resources that deploy it under /nuxeo/dashboard/.</description>

  <properties>
    <!-- Consumed by the npm-test execution below so that -DskipTests behaves as expected -->
    <skipTests>false</skipTests>
  </properties>

  <build>
    <plugins>

      <!-- Downloads a pinned node/npm into ./node so the build does not depend on the ambient toolchain -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <phase>initialize</phase>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
          </execution>
          <execution>
            <id>npm-install</id>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>install --no-audit --no-fund</arguments>
            </configuration>
            <goals>
              <goal>npm</goal>
            </goals>
          </execution>
          <execution>
            <id>npm-build</id>
            <phase>process-resources</phase>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
            <goals>
              <goal>npm</goal>
            </goals>
          </execution>
          <!-- Rewrites the Angular <base href> into a JSP expression reading the app.base.url property -->
          <execution>
            <id>npm-nuxeo-jsp</id>
            <phase>process-resources</phase>
            <configuration>
              <arguments>run nuxeo:jsp</arguments>
            </configuration>
            <goals>
              <goal>npm</goal>
            </goals>
          </execution>
          <execution>
            <id>npm-test</id>
            <phase>test</phase>
            <configuration>
              <arguments>test</arguments>
              <skip>${skipTests}</skip>
            </configuration>
            <goals>
              <goal>npm</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Copies the Angular output and the Nuxeo bundle resources into the jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-angular-app</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/nuxeo.war/dashboard</outputDirectory>
              <resources>
                <resource>
                  <directory>${basedir}/dist/nuxeo-labs-repository-dashboard/browser</directory>
                  <excludes>
                    <!-- index.html is replaced by the generated index.jsp -->
                    <exclude>index.html</exclude>
                  </excludes>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-nuxeo-resources</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <resources>
                <resource>
                  <directory>${basedir}/nuxeo</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestFile>${basedir}/nuxeo/META-INF/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <configuration>
          <filesets>
            <fileset>
              <directory>${basedir}/dist</directory>
            </fileset>
            <fileset>
              <directory>${basedir}/.angular</directory>
            </fileset>
          </filesets>
        </configuration>
      </plugin>

    </plugins>
  </build>

</project>
