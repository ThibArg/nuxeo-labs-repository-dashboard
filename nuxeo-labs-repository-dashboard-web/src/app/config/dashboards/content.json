{
  "id": "content",
  "label": "Content Dashboard",
  "filters": [
    {
      "type": "dateRange",
      "field": "dc:created",
      "default": "all"
    },
    {
      "type": "pathScope",
      "label": "Location"
    },
    {
      "type": "termsGroup",
      "id": "kind",
      "label": "Document kinds",
      "combine": "or",
      "members": [
        {
          "id": "types",
          "field": "ecm:primaryType",
          "label": "Document types",
          "labels": "doctype",
          "size": 200
        },
        {
          "id": "facets",
          "field": "ecm:mixinType",
          "label": "Facets",
          "size": 200,
          "note": "A document carries several facets, so these counts overlap."
        }
      ]
    }
  ],
  "layout": [
    {
      "cells": [
        { "use": "total-documents", "as": "totalAll", "span": 4 },
        {
          "use": "live-documents",
          "as": "liveNotTrashed",
          "span": 2,
          "hint": "Scope of every chart below"
        },
        { "use": "versions", "as": "versions", "span": 2 },
        { "use": "proxies", "as": "proxies", "span": 2 },
        { "use": "trashed-documents", "as": "trashed", "span": 2 }
      ]
    },
    {
      "cells": [
        { "use": "documents-expiring-this-week", "as": "expiringWeek", "span": 4 },
        { "use": "documents-expiring-in-60-days", "as": "expiring60", "span": 4 },
        { "use": "documents-expired", "as": "expired", "span": 4 }
      ]
    },
    {
      "cells": [
        { "use": "documents-by-type", "as": "byType", "span": 6 },
        { "use": "documents-by-lifecycle-state", "as": "byState", "span": 6 }
      ]
    },
    {
      "cells": [
        {
          "use": "documents-created",
          "as": "createdTrend",
          "span": 12,
          "spanByRange": { "7d": 6, "30d": 6 }
        },
        {
          "use": "documents-modified",
          "as": "modifiedTrend",
          "span": 12,
          "spanByRange": { "7d": 6, "30d": 6 }
        }
      ]
    },
    {
      "cells": [{ "use": "top-contributors", "as": "topContributors", "span": 12 }]
    }
  ]
}
