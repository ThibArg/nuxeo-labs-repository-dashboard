{
  "id": "tasks",
  "label": "Tasks Dashboard",
  "subtitle": "Open tasks only. A nightly job deletes finished workflows and every task they carry, so completed tasks are not counted here — the Workflows dashboard reads them from the audit, which keeps them. Set nuxeo.routing.disable.cleanup.workflow.instances=true to retain them in the repository.",
  "filters": [
    {
      "type": "termsGroup",
      "id": "assignees",
      "label": "Assignees",
      "combine": "or",
      "members": [
        {
          "id": "actors",
          "field": "nt:actors",
          "label": "Assignees",
          "labels": "user",
          "lookup": "user",
          "size": 20,
          "note": "A task may be assigned to a group as well as to a person."
        }
      ]
    }
  ],
  "layout": [
    {
      "cells": [
        { "use": "open-tasks", "as": "openTasks", "span": 3 },
        { "use": "overdue-tasks", "as": "overdue", "span": 3 },
        { "use": "tasks-due-this-week", "as": "dueThisWeek", "span": 3 },
        { "use": "distinct-assignees", "as": "assignees", "span": 3 }
      ]
    },
    {
      "cells": [
        { "use": "task-lateness", "as": "lateness", "span": 6 },
        { "use": "tasks-by-assignee", "as": "byAssignee", "span": 6 }
      ]
    },
    {
      "cells": [
        { "use": "overdue-tasks-by-assignee", "as": "overdueByAssignee", "span": 6 },
        { "use": "tasks-by-name", "as": "byTaskType", "span": 6 }
      ]
    },
    {
      "cells": [{ "use": "overdue-tasks-table", "as": "overdueTable", "span": 12 }]
    }
  ]
}
