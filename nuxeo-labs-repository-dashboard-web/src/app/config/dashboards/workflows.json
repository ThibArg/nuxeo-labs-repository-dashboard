{
  "id": "workflows",
  "label": "Workflows Dashboard",
  "filters": [
    {
      "type": "dateRange",
      "field": "eventDate",
      "default": "30d"
    },
    {
      "type": "termsGroup",
      "id": "models",
      "label": "Workflow models",
      "combine": "or",
      "members": [
        {
          "id": "modelName",
          "field": "extended.modelName",
          "label": "Models",
          "labels": "workflowModel",
          "size": 50
        }
      ]
    }
  ],
  "layout": [
    {
      "cells": [
        { "use": "workflows-started", "as": "started", "span": 3 },
        { "use": "workflows-completed", "as": "completed", "span": 3 },
        { "use": "workflows-cancelled", "as": "cancelled", "span": 3 },
        { "use": "workflow-tasks-created", "as": "tasksCreated", "span": 3 }
      ]
    },
    {
      "cells": [
        {
          "use": "average-workflow-duration",
          "as": "averageDuration",
          "span": 3,
          "hint": "Every model at once, which no single model resembles — see the breakdown below"
        },
        { "use": "median-workflow-duration", "as": "medianDuration", "span": 3 },
        { "use": "average-task-duration", "as": "averageTaskDuration", "span": 3 },
        { "use": "workflow-tasks-ended", "as": "tasksEnded", "span": 3 }
      ]
    },
    {
      "cells": [
        {
          "use": "slowest-workflow-models",
          "as": "durationByModel",
          "span": 6,
          "hint": "Slowest first. This is where the overall average comes from"
        },
        {
          "use": "slowest-task-steps",
          "as": "slowestSteps",
          "span": 6,
          "hint": "Average time a task waits before it is answered — filter by model to isolate one process"
        }
      ]
    },
    {
      "cells": [
        { "use": "workflows-started-per-day", "as": "startedPerDay", "span": 6 },
        { "use": "workflows-completed-per-day", "as": "completedPerDay", "span": 6 }
      ]
    },
    {
      "cells": [
        { "use": "workflows-by-model", "as": "byModel", "span": 6 },
        { "use": "task-outcomes", "as": "taskOutcomes", "span": 6 }
      ]
    },
    {
      "cells": [
        { "use": "top-workflow-initiators", "as": "topInitiators", "span": 6 },
        { "use": "top-task-performers", "as": "topTaskPerformers", "span": 6 }
      ]
    },
    {
      "cells": [
        { "use": "workflow-tasks-by-step", "as": "byTaskName", "span": 6 },
        { "use": "workflow-duration-distribution", "as": "durationDistribution", "span": 6 }
      ]
    }
  ]
}
