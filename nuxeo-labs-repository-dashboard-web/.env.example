# Template. Copy to .env and fill it in; .env is gitignored, this file is not.
# Never put real credentials here.
#
# Used by src/proxy.conf.mjs when running `npm start`.

NUXEO_URL=http://localhost:8080

# Base64 of "<username>:<password>", which you can produce with:
#   printf 'myuser:mypassword' | base64
NUXEO_AUTHORIZATION=Basic <replace-me>
