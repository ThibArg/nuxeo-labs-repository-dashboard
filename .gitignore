# Maven. Packaged artefacts all land in target/, which is enough: a *.war rule would also
# match nuxeo/web/nuxeo.war/, a source directory holding the Web UI slot and its translations.
target/
*.class

# Node
node_modules/
node/
.angular/
dist/
npm-debug.log*
.npm/

# Environment
.env
.env.*
!.env.example

# IDE
.idea/
*.iml
.classpath
.project
.settings/
.vscode/*
!.vscode/extensions.json
dev_null

# OS
.DS_Store
Thumbs.db
